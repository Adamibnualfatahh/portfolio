---
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? currentPath === "/" : currentPath.startsWith(path);
---
<nav aria-label="Navigasi utama" class="mx-auto w-full border-y border-white bg-black lg:fixed lg:inset-x-0 lg:top-0 lg:z-50" x-data="{ open: false }">
  <div class="mx-auto bg-black w-full">
    <div class="mx-auto border-white border-x max-w-7xl flex flex-col lg:flex-row lg:items-center lg:justify-between w-full">
      
      <!-- Mobile Header: Logo + Toggle -->
      <div class="flex items-center justify-between w-full lg:w-auto px-4 py-4 md:px-8 lg:p-0 border-b lg:border-none border-white">
        <a href="/" class="text-white text-xs font-display inline-flex items-center uppercase lg:px-8 lg:py-4">
          <span>Adam Ibnu Alfatah &nbsp; &rarr;</span>
        </a>
        
        <!-- Mobile Menu Button -->
        <button @click="open = !open" :aria-expanded="open.toString()" aria-controls="primary-navigation" class="ml-auto p-2 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-carrot lg:hidden" aria-label="Buka menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path x-show="!open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              <path x-show="open" style="display: none;" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Links (Collapsible on mobile) -->
      <div id="primary-navigation" :class="{'flex': open, 'hidden': !open}" class="hidden w-full flex-col border-white lg:ml-auto lg:flex lg:w-auto lg:flex-row">
        <a
          href="/blogs"
          aria-current={isActive("/blogs") ? "page" : undefined}
          class={`w-full border-b border-white px-6 py-4 text-center font-display text-xs uppercase transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-carrot lg:w-auto lg:border-b-0 lg:border-l ${isActive("/blogs") ? "bg-black text-white" : "bg-white text-black hover:bg-black hover:text-white"}`}
        >Blog</a>
        <a
          href="/projects"
          aria-current={isActive("/projects") ? "page" : undefined}
          class={`w-full border-b border-white px-6 py-4 text-center font-display text-xs uppercase transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-carrot lg:w-auto lg:border-b-0 lg:border-l ${isActive("/projects") ? "bg-black text-white" : "bg-white text-black hover:bg-black hover:text-white"}`}
        >Projects</a>
        <a
          href="/about"
          aria-current={isActive("/about") ? "page" : undefined}
          class={`w-full border-white px-6 py-4 text-center font-display text-xs uppercase transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-white lg:w-auto lg:border-l ${isActive("/about") ? "bg-black text-white" : "bg-carrot text-black hover:text-white"}`}
        >About</a>
      </div>

    </div>
  </div>
</nav>
