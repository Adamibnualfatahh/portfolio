<button
  id="back-to-top"
  type="button"
  tabindex="-1"
  aria-hidden="true"
  aria-label="Kembali ke atas"
  class="fixed bottom-6 left-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-white text-black shadow-lg opacity-0 pointer-events-none translate-y-2 transition-all duration-200 hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-carrot"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');

  function toggleVisibility() {
    if (!btn) return;
    const visible = window.scrollY > 400;
    btn.classList.toggle('opacity-0', !visible);
    btn.classList.toggle('pointer-events-none', !visible);
    btn.classList.toggle('translate-y-2', !visible);
    btn.tabIndex = visible ? 0 : -1;
    btn.setAttribute('aria-hidden', String(!visible));
  }

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  });

  window.addEventListener('scroll', toggleVisibility, { passive: true });
  document.addEventListener('astro:page-load', toggleVisibility);
  toggleVisibility();
</script>
