  {
    title: "Kemnaker Skillhub",
    description:
      "A vocational learning platform that helps Indonesian talent build practical, job-ready skills.",
    img: skillhub,
    demo: "https://skillhub.kemnaker.go.id/",
    label: "Government Platform",
  },
  {
    title: "Kemnaker Karirhub",
    description:
      "A national career platform connecting job seekers with opportunities and employers.",
    img: karirhub,
    demo: "https://karirhub.kemnaker.go.id/",
    label: "Government Platform",
  },
  {
    title: "Kerjoo.com",
    description:
      "A product website for an HRIS platform covering attendance, payroll, and workforce operations.",
    img: kerjoo,
    demo: "https://kerjoo.com/",
    label: "SaaS Product",
  },
  {
    title: "Kerjoo Chat",
    description:
      "A multi-agent WhatsApp customer service dashboard for faster, more coordinated support.",
    img: kerjooChat,
    demo: "https://kerjoo.com/",
    label: "Customer Service",
  },
  {
    title: "Kerjoo Invoice",
    description:
      "An invoicing workspace for managing business documents, customers, and incoming payments.",
    img: kerjooInvoice,
    demo: "https://kerjoo.com/",
    label: "Business Operations",
  },
  {
    title: "Lika.id",
    description:
      "A responsive production website designed around a clear and approachable user experience.",
    img: lika,
    demo: "https://lika.id/",
