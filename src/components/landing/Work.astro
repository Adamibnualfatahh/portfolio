    img: work1,
    code: "https://github.com/Adamibnualfatahh/hospital-room-availability",
    demo: "https://hospital-room-availability.vercel.app/",
    label: "Healthcare",
  },
  {
    title: "GitHub Profile Finder",
    description:
      "A fast profile explorer for reviewing public GitHub information in one place.",
    img: work2,
    code: "https://github.com/Adamibnualfatahh/github-finder",
    demo:
      "https://github-finder-virid-ten.vercel.app/?username=adamibnualfatahh",
    label: "Developer Tool",
  },
  {
    title: "Moonton Streaming Platform",
    description:
      "A streaming platform interface exploring content discovery and media browsing.",
    img: work3,
