---

<section
  class="border-b border-white bg-black"
  aria-labelledby="projects-title"
>
  <div class="gradient-grid mx-auto max-w-7xl border-x border-white">
    <header class="grid gap-10 px-6 py-16 md:px-10 lg:grid-cols-[1fr_22rem] lg:items-end lg:px-12 lg:py-24">
      <div class="max-w-4xl">
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.28em] text-carrot">
          Selected work / {professionalProjects.length + independentProjects.length} projects
        </p>
        <h1
          id="projects-title"
          class="font-display text-4xl uppercase leading-[0.92] text-white sm:text-5xl lg:text-7xl"
        >
          Products built for real-world use.
        </h1>
      </div>

      <div>
        <p class="text-sm leading-7 text-white/80">
          A selection of production platforms and independent experiments,
          shaped by backend engineering and end-to-end product delivery.
        </p>
        <a
          href="#professional-work"
          class="mt-6 inline-flex items-center gap-3 border-b border-carrot pb-2 font-mono text-xs uppercase tracking-[0.18em] text-white hover:text-carrot"
        >
          Explore projects
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </header>

    <dl class="grid border-t border-white sm:grid-cols-3">
      <div class="border-b border-white px-6 py-6 sm:border-b-0 sm:border-r lg:px-10">
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-white/75">
          Professional work
        </dt>
        <dd class="mt-2 font-display text-3xl text-white">
          {String(professionalProjects.length).padStart(2, "0")}
        </dd>
      </div>
      <div class="border-b border-white px-6 py-6 sm:border-b-0 sm:border-r lg:px-10">
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-white/75">
          Independent projects
        </dt>
        <dd class="mt-2 font-display text-3xl text-white">
          {String(independentProjects.length).padStart(2, "0")}
        </dd>
      </div>
      <div class="px-6 py-6 lg:px-10">
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-white/75">
          Core perspective
        </dt>
        <dd class="mt-3 text-sm font-semibold uppercase tracking-wider text-white">
          Backend-first
        </dd>
      </div>
    </dl>
  </div>
</section>

<section
  id="professional-work"
  class="scroll-mt-16 border-b border-white bg-black"
  aria-labelledby="professional-work-title"
>
  <div class="mx-auto max-w-7xl border-x border-white">
    <header class="grid gap-5 border-b border-white px-6 py-10 md:grid-cols-[1fr_auto] md:items-end md:px-10 lg:px-12">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.24em] text-carrot">
          Client &amp; team delivery
        </p>
        <h2
          id="professional-work-title"
          class="font-display text-3xl uppercase leading-none text-white md:text-5xl"
        >
          Professional Work
        </h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-white/80 md:text-right">
        Production products delivered for government services, SaaS teams, and
        growing digital businesses.
      </p>
    </header>

    <div class="grid lg:grid-cols-2">
      {
        professionalProjects.map((project, index) => (
          <article
            class:list={[
              "group flex min-h-full flex-col border-white bg-[#161616] transition-colors duration-300 hover:bg-[#1b1b1b]",
              index % 2 === 0 && "lg:border-r",
              index < professionalProjects.length - 2 && "border-b",
              index === professionalProjects.length - 2 && "border-b lg:border-b-0",
            ]}
          >
            <a
              href={project.demo ?? undefined}
              target="_blank"
              rel="noreferrer"
              class="relative block aspect-[16/10] overflow-hidden border-b border-white/20 bg-white/5"
              aria-label={`Visit ${project.title} website`}
            >
              <Image
                src={project.img}
                alt={`${project.title} project preview`}
                width={960}
                height={600}
                loading="lazy"
                format="webp"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025] group-hover:opacity-90"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent" />
              <span class="absolute left-4 top-4 border border-white/30 bg-black/80 px-3 py-2 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-white backdrop-blur-sm">
                {project.label}
              </span>
              <span class="absolute bottom-4 right-4 flex h-11 w-11 items-center justify-center rounded-full border border-white bg-black text-lg text-white transition duration-300 group-hover:-translate-y-1 group-hover:bg-carrot">
                <span class="sr-only">Open project</span>
                <span aria-hidden="true">↗</span>
              </span>
            </a>

            <div class="flex flex-1 flex-col p-6 md:p-8">
              <div class="mb-5 flex items-start justify-between gap-6">
                <h3 class="font-display text-2xl uppercase leading-tight text-white md:text-3xl">
                  {project.title}
                </h3>
                <span class="shrink-0 font-mono text-xs tracking-[0.2em] text-carrot">
                  /{String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <p class="mb-8 max-w-xl text-sm leading-6 text-white/80">
                {project.description}
              </p>
              <dl class="mb-8 grid grid-cols-2 gap-4 border-y border-white/20 py-4">
                <div>
                  <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-white/70">Role</dt>
                  <dd class="mt-2 text-xs font-semibold uppercase tracking-wider text-white">Backend &amp; product</dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-white/70">Focus</dt>
                  <dd class="mt-2 text-xs font-semibold uppercase tracking-wider text-white">{project.label}</dd>
                </div>
              </dl>
              {project.demo ? (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-auto inline-flex items-center justify-between border-t border-white/20 pt-4 font-mono text-xs uppercase tracking-[0.18em] text-white hover:border-carrot hover:text-carrot"
                >
                  Visit website
                  <span class="text-base" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="mt-auto inline-flex items-center justify-between border-t border-white/20 pt-4 font-mono text-xs uppercase tracking-[0.18em] text-white/60">
                  Case study available
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  class="border-b border-white bg-accent-500"
  aria-labelledby="independent-projects-title"
>
  <div class="mx-auto max-w-7xl border-x border-white">
    <header class="gradient-grid grid gap-5 border-b border-white px-6 py-10 md:grid-cols-[1fr_auto] md:items-end md:px-10 lg:px-12">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.24em] text-carrot">
          Learning through building
        </p>
        <h2
          id="independent-projects-title"
          class="font-display text-3xl uppercase leading-none text-white md:text-5xl"
        >
          Independent Projects
        </h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-black/75 md:text-right">
        Focused experiments, open-source tools, and product ideas built from
        curiosity.
      </p>
    </header>

    <div class="grid gap-px bg-white md:grid-cols-2 xl:grid-cols-3">
      {
        independentProjects.map((project, index) => (
          <article class="group flex min-h-full flex-col bg-accent-500 p-4 transition-colors duration-300 hover:bg-[#151515] md:p-6">
            <a
              href={project.demo ?? project.code ?? undefined}
              target="_blank"
              rel="noreferrer"
              class="relative block aspect-video overflow-hidden border border-white/20 bg-black"
              aria-label={`View ${project.title}`}
            >
              <Image
                src={project.img}
                alt={`${project.title} project preview`}
                width={720}
                height={405}
                loading="lazy"
                format="webp"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04] group-hover:opacity-80"
              />
              <span class="absolute left-3 top-3 border border-white/30 bg-black/80 px-3 py-2 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-white backdrop-blur-sm">
                {project.label}
              </span>
            </a>

            <div class="flex flex-1 flex-col px-1 pb-1 pt-6">
              <div class="mb-4 flex items-start justify-between gap-4">
                <h3 class="font-display text-xl uppercase leading-tight text-white">
                  {project.title}
                </h3>
                <span class="shrink-0 font-mono text-[0.65rem] tracking-[0.18em] text-carrot">
                  /{String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <p class="mb-6 text-sm leading-6 text-black/75">
                {project.description}
              </p>

              <div class="mt-auto grid grid-cols-2 gap-2 border-t border-white/20 pt-4">
                {project.code ? (
                  <a
                    href={project.code}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center justify-center gap-2 border border-white/30 px-3 py-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-white hover:border-white hover:bg-white hover:text-black"
                  >
                    Source
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="inline-flex items-center justify-center border border-white/10 px-3 py-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-white/40">
                    Source private
                  </span>
                )}
                {project.demo ? (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center justify-center gap-2 border border-carrot bg-carrot px-3 py-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-white hover:bg-white hover:text-black"
                  >
                    Live site
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="inline-flex cursor-not-allowed items-center justify-center border border-white/10 px-3 py-3 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-white/40">
                    No preview
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
