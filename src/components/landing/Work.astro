  {
    title: "Kalkulator Nusantara",
    description:
      "A collection of practical calculators designed for everyday needs in Indonesia.",
    img: work10,
    code: "https://github.com/Adamibnualfatahh/kalkulator-nusantara",
    demo: "https://kalkulator-sehat-nusantara.vercel.app/",
    label: "Web Utility",
  },
  {
    title: "Jogo Rogo",
    description:
      "A focused wellness experience that turns healthy routines into simple daily actions.",
    img: work9,
    code: "https://github.com/Adamibnualfatahh/jogo-rogo",
