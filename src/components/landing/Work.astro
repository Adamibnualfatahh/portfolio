  },
  {
    title: "Agent of Clean",
    description:
      "A multi-brand care and cleaning platform for shoe, bag, and laundry services in Solo.",
    img: agentOfClean,
    demo: null,
    label: "Service Platform",
  },
  {
    title: "KindboLab",
    description:
      "A creative activity website for children with class registration, events, and editable content.",
    img: kindboLab,
    demo: null,
    label: "Creative Education",
  },
  {
    title: "Solo Shuttlecock",
    description:
      "A digital profile for the Serengan shuttlecock centre, its craft, community, and industrial tourism.",
    img: soloShuttlecock,
