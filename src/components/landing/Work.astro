import lika from "../../assets/work/lika.png";
import mauren from "../../assets/work/mauren.png";
import agentOfClean from "../../assets/work/agent-of-clean.webp";
import kindboLab from "../../assets/work/kindbolab.webp";
import soloShuttlecock from "../../assets/work/solo-shuttle.webp";
