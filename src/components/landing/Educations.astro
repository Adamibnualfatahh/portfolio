---
import { Image } from "astro:assets";
import telu from "../../assets/TelU.webp";
import smk from "../../assets/SMKN2.png";
---
<section class="border-white border-b">
  <div class="mx-auto border-white border-x max-w-7xl">
    <div class="border-b border-white p-6 md:p-10 lg:p-12">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.24em] text-carrot">Learning path</p>
      <h2 class="font-display text-3xl uppercase text-white md:text-5xl">Education</h2>
    </div>
    <div class="grid md:grid-cols-2">
      <article class="flex gap-5 border-b border-white p-6 md:border-b-0 md:border-r md:p-10">
        <Image src={telu} alt="Logo Telkom University" class="h-16 w-16 shrink-0" loading="lazy" />
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-carrot">2023 — Present</p>
          <h3 class="mt-3 font-display text-2xl uppercase text-white">Telkom University</h3>
          <p class="mt-2 text-sm leading-6 text-eagle">Informatics Engineering</p>
        </div>
      </article>
      <article class="flex gap-5 p-6 md:p-10">
        <Image src={smk} alt="Logo SMK Negeri 2 Karanganyar" class="h-16 w-16 shrink-0 object-contain" loading="lazy" />
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-carrot">2019 — 2022</p>
          <h3 class="mt-3 font-display text-2xl uppercase text-white">SMK N 2 Karanganyar</h3>
          <p class="mt-2 text-sm leading-6 text-eagle">Software Engineering</p>
        </div>
      </article>
    </div>
  </div>
</section>
