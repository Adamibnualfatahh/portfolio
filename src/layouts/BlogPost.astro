---
import BaseLayout from "./BaseLayout.astro";
import Disqus from "../components/global/Disqus.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
export const prerender = true;

export interface Props {
    title: string;
    description: string;
    publishDate?: string | Date;
    updatedDate?: string | Date;
    heroImage?: ImageMetadata;
    author?: string | { name: string };
    tags?: string[];
    readDuration?: number;
    slug?: string;
}

const {
    title, description, publishDate, updatedDate, heroImage, author, tags, readDuration, slug
} = Astro.props;

const formattedPublishDate = publishDate ? new Date(publishDate).toLocaleDateString('id-ID', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Jakarta'
}) : '';
const morePosts = (await getCollection('blog'))
    .filter((post) => post.slug !== slug)
    .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
    .slice(0, 3);
---
<BaseLayout title={`Adam Ibnu | ${title}`} description={description}>
    <!-- Reading progress bar -->
    <div id="reading-progress-track" class="fixed top-0 left-0 right-0 z-[60] h-1 bg-white/10 lg:top-0">
        <div id="reading-progress-bar" class="h-full bg-carrot" style="width:0%"></div>
    </div>

    <section class="border-b border-white bg-black">
        <div class="mx-auto max-w-7xl border-x border-white">
        <article lang="id" class="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-24">
            <a href="/blogs" class="mb-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-eagle transition-colors hover:text-carrot">← All stories</a>
            {heroImage && (
                <Image src={heroImage} alt={title} class="aspect-[16/9] w-full border border-white/20 object-cover" loading="eager" />
            )}
            <header class="border-b border-white/20 py-8 md:py-10">
                <div class="mb-5 flex flex-wrap gap-2">
                    {tags?.map((tag) => (
                        <span class="border border-white/20 px-3 py-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-carrot">{tag}</span>
                    ))}
                </div>
                <h1 class="font-display text-4xl uppercase leading-[0.95] text-white md:text-6xl">{title}</h1>
                <p class="mt-5 text-base leading-7 text-eagle">{description}</p>
                <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-white/70">
                    <span>{formattedPublishDate}</span>
                    {readDuration && <span>{readDuration} min read</span>}
                    <span>{typeof author === 'string' ? author : author?.name}</span>
                </div>
            </header>
            <div class="article-body prose prose-invert mt-10 max-w-none prose-a:text-carrot prose-blockquote:border-l-carrot prose-blockquote:text-eagle prose-code:text-carrot prose-headings:font-display prose-headings:uppercase prose-headings:tracking-tight prose-li:marker:text-carrot prose-pre:border prose-pre:border-white/20">
                <slot/>
            </div>
        </article>

        <section class="mx-auto max-w-5xl border-y border-white px-5 py-10 md:px-8" aria-labelledby="keep-reading-title">
            <div class="mb-6 flex items-end justify-between">
                <h2 id="keep-reading-title" class="font-display text-2xl uppercase text-white md:text-3xl">Keep reading</h2>
                <a href="/blogs" class="font-mono text-xs uppercase tracking-[0.16em] text-eagle hover:text-carrot">All stories ↗</a>
            </div>
            <div class="grid gap-px bg-white/20 md:grid-cols-3">
                {morePosts.map((post) => (
                    <a href={`/blog/${post.slug}`} class="group flex min-h-44 flex-col justify-between bg-accent-500 p-5 transition-colors hover:bg-white">
                        <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-carrot">{post.data.publishDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                        <span class="font-display text-xl uppercase leading-tight text-white transition-colors group-hover:text-black">{post.data.title}</span>
                    </a>
                ))}
            </div>
        </section>

        <Disqus/>
        </div>
    </section>

    <!-- Floating listen button -->
    <button id="listen-btn" aria-label="Dengarkan artikel ini" class="fixed bottom-6 right-6 z-50 flex items-center gap-2 rounded-full bg-white text-black px-4 py-3 text-sm font-semibold shadow-lg hover:bg-gray-100" style="transition: opacity 0.2s, transform 0.2s">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
        </svg>
        Dengarkan
    </button>

    <!-- Floating player -->
    <div id="player" class="fixed bottom-6 right-6 z-50 w-72 rounded-2xl bg-white text-black shadow-2xl overflow-hidden" style="display:none;opacity:0;transform:translateY(8px);transition:opacity 0.2s,transform 0.2s">
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
            <div class="flex items-end gap-0.5 h-4" id="wave">
                <span class="wave-bar"></span>
                <span class="wave-bar"></span>
                <span class="wave-bar"></span>
                <span class="wave-bar"></span>
                <span class="wave-bar"></span>
            </div>
            <span class="text-xs font-semibold tracking-wide uppercase text-gray-500 ml-2 flex-1">Sedang Dibaca</span>
            <button id="player-close" aria-label="Tutup" class="p-1 rounded-full hover:bg-gray-100 text-gray-400 hover:text-black" style="transition:color 0.15s">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        <div class="px-4 pt-3 pb-1">
            <p class="text-sm font-bold leading-snug" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{title}</p>
            <p class="text-xs text-gray-400 mt-0.5">{typeof author === 'string' ? author : author?.name}</p>
        </div>

        <div class="px-4 pt-2 pb-1">
            <div class="w-full h-1 bg-gray-100 rounded-full overflow-hidden">
                <div id="progress" class="h-full bg-black rounded-full" style="width:0%;transition:width 0.3s linear"></div>
            </div>
            <div class="flex justify-between mt-1">
                <span id="current-word" class="text-xs text-gray-400 truncate max-w-48"></span>
                <span id="pct" class="text-xs text-gray-400 ml-2 shrink-0">0%</span>
            </div>
        </div>

        <div class="flex items-center justify-center gap-4 px-4 py-3">
            <button id="btn-rewind" aria-label="Mundur 10 detik" class="p-2 rounded-full hover:bg-gray-100 text-gray-500 hover:text-black" style="transition:color 0.15s,background 0.15s">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 5V2L7 7l5 5V8c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                </svg>
            </button>
            <button id="btn-play" aria-label="Play" class="w-11 h-11 rounded-full bg-black text-white flex items-center justify-center hover:bg-gray-800 shrink-0" style="transition:background 0.15s">
                <svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                </svg>
            </button>
            <button id="btn-speed" aria-label="Ubah kecepatan membaca" class="w-10 h-10 rounded-full hover:bg-gray-100 text-xs font-bold text-gray-500 hover:text-black flex items-center justify-center" style="transition:color 0.15s,background 0.15s">1x</button>
        </div>
    </div>
</BaseLayout>

<style>
    .wave-bar {
        display: inline-block;
        height: 4px;
        width: 2px;
        border-radius: 9999px;
        background: black;
    }
    #wave.on .wave-bar:nth-child(1) { animation: wb 0.8s ease-in-out infinite 0.0s; }
    #wave.on .wave-bar:nth-child(2) { animation: wb 0.8s ease-in-out infinite 0.15s; }
    #wave.on .wave-bar:nth-child(3) { animation: wb 0.8s ease-in-out infinite 0.3s; }
    #wave.on .wave-bar:nth-child(4) { animation: wb 0.8s ease-in-out infinite 0.45s; }
    #wave.on .wave-bar:nth-child(5) { animation: wb 0.8s ease-in-out infinite 0.6s; }
    @keyframes wb { 0%,100%{ height:4px } 50%{ height:14px } }
</style>

<script>
    const SPEEDS = [0.75, 1, 1.25, 1.5, 2, 3];
    let si = 1;
    let words: string[] = [];
    let wi = 0;
    let utt: SpeechSynthesisUtterance | null = null;
    let playing = false;
    let voice: SpeechSynthesisVoice | null = null;
    let lastFrom = 0;      // kata awal saat speak() dipanggil
    let lastCharIndex = 0; // charIndex terakhir dari onboundary

    const listenBtn  = document.getElementById('listen-btn')!;
    const player     = document.getElementById('player')!;
    const closeBtn   = document.getElementById('player-close')!;
    const playBtn    = document.getElementById('btn-play')!;
    const playIcon   = document.getElementById('play-icon')!;
    const rewindBtn  = document.getElementById('btn-rewind')!;
    const speedBtn   = document.getElementById('btn-speed')!;
    const progressEl = document.getElementById('progress')!;
    const pctEl      = document.getElementById('pct')!;
    const wordEl     = document.getElementById('current-word')!;
    const wave       = document.getElementById('wave')!;

    const PAUSE_PATH = `<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>`;
    const PLAY_PATH  = `<path d="M8 5v14l11-7z"/>`;

    /* ── Voice selection: prefer male Indonesian ── */
    function pickVoice() {
        const all = speechSynthesis.getVoices();
        // 1. Indonesian male by name hint
        let v = all.find(v => v.lang.startsWith('id') && /male|man|pria|laki/i.test(v.name));
        // 2. Any Indonesian
        if (!v) v = all.find(v => v.lang === 'id-ID');
        if (!v) v = all.find(v => v.lang.startsWith('id'));
        // 3. English male fallback
        if (!v) v = all.find(v => v.lang.startsWith('en') && /male|man|david|mark|daniel|james/i.test(v.name));
        // 4. Whatever's available
        if (!v) v = all[0] ?? null;
        voice = v;
    }

    /* ── Extract article body ── */
    function getText(): string {
        const prose = document.querySelector('.article-body');
        if (!prose) return '';
        const clone = prose.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('img,button,pre,code').forEach(e => e.remove());
        return clone.innerText
            .replace(/wkwk+/gi, 'haha')
            .replace(/[^\w\s.,!?;:'"()-]/g, ' ')
            .replace(/\s+/g, ' ').trim();
    }

    /* ── Progress ── */
    function updateProgress(i: number) {
        wi = i;
        const p = words.length ? Math.round(i / words.length * 100) : 0;
        progressEl.style.width = p + '%';
        pctEl.textContent = p + '%';
        wordEl.textContent = words.slice(i, i + 4).join(' ');
    }

    /* ── Speak from word index ── */
    function speak(from = 0) {
        speechSynthesis.cancel();
        const text = words.slice(from).join(' ');
        if (!text.trim()) return;

        lastFrom = from;
        lastCharIndex = 0;

        const thisUtt = new SpeechSynthesisUtterance(text);
        utt = thisUtt;
        thisUtt.lang = 'id-ID';
        thisUtt.rate = SPEEDS[si];
        thisUtt.pitch = voice?.lang.startsWith('id') ? 0.9 : 0.8;
        thisUtt.volume = 1;
        if (voice) thisUtt.voice = voice;

        thisUtt.onboundary = e => {
            if (utt !== thisUtt) return; // utterance lama, abaikan
            if (e.name !== 'word') return;
            lastCharIndex = e.charIndex;
            const spoken = text.substring(0, e.charIndex).trim().split(/\s+/).filter(Boolean).length;
            updateProgress(from + spoken);
        };
        thisUtt.onend = () => {
            if (utt !== thisUtt) return; // utterance lama, abaikan
            setPlaying(false);
            updateProgress(words.length);
        };
        thisUtt.onerror = () => {
            if (utt !== thisUtt) return; // utterance lama, abaikan
            setPlaying(false);
        };

        speechSynthesis.speak(thisUtt);
        setPlaying(true);
    }

    /* ── Hitung posisi kata saat ini dari charIndex terakhir ── */
    function currentWordIndex(): number {
        const text = words.slice(lastFrom).join(' ');
        const spoken = text.substring(0, lastCharIndex).trim().split(/\s+/).filter(Boolean).length;
        return lastFrom + spoken;
    }

    /* ── UI state ── */
    function setPlaying(v: boolean) {
        playing = v;
        playIcon.innerHTML = v ? PAUSE_PATH : PLAY_PATH;
        wave.classList.toggle('on', v);
    }

    function showPlayer() {
        listenBtn.style.display = 'none';
        player.style.display = 'block';
        requestAnimationFrame(() => {
            player.style.opacity = '1';
            player.style.transform = 'translateY(0)';
        });
    }

    function hidePlayer() {
        player.style.opacity = '0';
        player.style.transform = 'translateY(8px)';
        setTimeout(() => { player.style.display = 'none'; listenBtn.style.display = 'flex'; }, 200);
        speechSynthesis.cancel();
        setPlaying(false);
        updateProgress(0);
        wi = 0;
    }

    /* ── Init voices (Chrome loads async) ── */
    function ensureVoice(): Promise<void> {
        return new Promise(res => {
            if (speechSynthesis.getVoices().length) { pickVoice(); res(); return; }
            speechSynthesis.onvoiceschanged = () => { pickVoice(); res(); };
        });
    }
    ensureVoice();

    /* ── Events ── */
    listenBtn.addEventListener('click', async () => {
        await ensureVoice();
        if (!words.length) words = getText().split(/\s+/).filter(Boolean);
        showPlayer();
        speak(0);
    });

    closeBtn.addEventListener('click', hidePlayer);

    playBtn.addEventListener('click', () => {
        if (playing) {
            speechSynthesis.pause();
            setPlaying(false);
        } else if (speechSynthesis.paused) {
            speechSynthesis.resume();
            setPlaying(true);
        } else {
            speak(wi);
        }
    });

    rewindBtn.addEventListener('click', () => speak(Math.max(0, currentWordIndex() - 30)));

    speedBtn.addEventListener('click', () => {
        si = (si + 1) % SPEEDS.length;
        speedBtn.textContent = SPEEDS[si] + 'x';
        // Selalu restart dari posisi akurat agar speed langsung apply
        speak(currentWordIndex());
    });

    /* ── Seek: klik progress bar ── */
    const progressTrack = progressEl.parentElement!;
    
    function seekTo(clientX: number) {
        const rect = progressTrack.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        const targetWord = Math.floor(ratio * words.length);
        speak(targetWord);
    }

    progressTrack.style.cursor = 'pointer';
    progressTrack.addEventListener('click', e => seekTo((e as MouseEvent).clientX));

    // Drag support
    let dragging = false;
    progressTrack.addEventListener('mousedown', e => { dragging = true; seekTo((e as MouseEvent).clientX); });
    document.addEventListener('mousemove', e => { if (dragging) seekTo((e as MouseEvent).clientX); });
    document.addEventListener('mouseup', () => { dragging = false; });

    // Touch support
    progressTrack.addEventListener('touchstart', e => seekTo(e.touches[0].clientX), { passive: true });
    progressTrack.addEventListener('touchmove', e => seekTo(e.touches[0].clientX), { passive: true });

    document.addEventListener('astro:before-swap', () => speechSynthesis.cancel());
</script>

<style is:global>
    .code-block-wrapper {
        position: relative;
        margin: 1.5em 0;
    }
    .code-block-wrapper pre {
        margin: 0 !important;
        padding-right: 2.75rem !important;
    }
    .code-copy-btn {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        color: #e5e5e5;
        background: rgba(255,255,255,0.1);
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.15s, background 0.15s, color 0.15s;
    }
    .code-block-wrapper:hover .code-copy-btn,
    .code-copy-btn:focus-visible {
        opacity: 1;
        visibility: visible;
    }
    .code-copy-btn:hover {
        background: rgba(255,255,255,0.2);
        color: #fff;
    }
    .code-copy-btn.copied {
        color: #22c55e;
        opacity: 1;
        visibility: visible;
    }
    .code-copy-btn svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
    }
    @media (hover: none) {
        .code-copy-btn {
            opacity: 0.6;
            visibility: visible;
        }
    }
</style>

<script>
    /* ── Reading progress bar ── */
    function updateReadingProgress() {
        const bar = document.getElementById('reading-progress-bar');
        if (!bar) return;
        const doc = document.documentElement;
        const scrollTop = window.scrollY;
        const scrollHeight = doc.scrollHeight - window.innerHeight;
        const pct = scrollHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / scrollHeight) * 100)) : 0;
        (bar as HTMLElement).style.width = pct + '%';
    }
    window.addEventListener('scroll', updateReadingProgress, { passive: true });
    window.addEventListener('resize', updateReadingProgress);
    document.addEventListener('astro:page-load', updateReadingProgress);
    updateReadingProgress();

    /* ── Copy-to-clipboard for code blocks ── */
    const COPY_ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK_ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    function initCodeCopyButtons() {
        const blocks = document.querySelectorAll('.prose pre');
        blocks.forEach((pre) => {
            if (pre.parentElement?.classList.contains('code-block-wrapper')) return; // avoid duplicates

            const wrapper = document.createElement('div');
            wrapper.className = 'code-block-wrapper';
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            const btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.type = 'button';
            btn.setAttribute('aria-label', 'Copy code to clipboard');
            btn.innerHTML = COPY_ICON;

            btn.addEventListener('click', async () => {
                const code = pre.querySelector('code');
                const text = code ? (code as HTMLElement).innerText : pre.textContent || '';
                try {
                    await navigator.clipboard.writeText(text);
                } catch {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                }
                btn.innerHTML = CHECK_ICON;
                btn.classList.add('copied');
                setTimeout(() => {
                    btn.innerHTML = COPY_ICON;
                    btn.classList.remove('copied');
                }, 2000);
            });

            wrapper.appendChild(btn);
        });
    }
    initCodeCopyButtons();
    document.addEventListener('astro:page-load', initCodeCopyButtons);
</script>
